<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/widget_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/address_hint"
        android:textColor="@color/ink_soft"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/widget_private"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/shortcut_private_long"
        android:padding="4dp"
        android:src="@drawable/ic_shortcut_private" />
</LinearLayout>
