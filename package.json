{
  "name": "zuri-browser",
  "version": "0.2.0",
  "description": "Zuri — navigateur web privé aux couleurs africaines",
  "homepage": "https://github.com/ftchouabe-coder/zuri-browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ftchouabe-coder/zuri-browser.git"
  },
  "bugs": {
    "url": "https://github.com/ftchouabe-coder/zuri-browser/issues"
  },
  "author": "Zuri contributors",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "npm run build && electron scripts/e2e.cjs",
    "smoke": "npm run build && electron scripts/smoke.cjs",
    "icon": "pwsh -NoProfile -File scripts/make-icon.ps1",
    "pack": "electron-vite build && electron-builder --win --dir --publish never",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@ghostery/adblocker-electron": "^2.20.3",
    "@ghostery/adblocker-electron-preload": "^2.20.3",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "af.zuri.browser",
    "productName": "Zuri",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Zuri-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Zuri-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ftchouabe-coder",
        "repo": "zuri-browser",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    }
  }
}
